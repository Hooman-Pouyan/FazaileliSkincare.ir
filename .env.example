# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development:  cp .env.example .env.local
# Every value below is a LOCAL DEVELOPMENT value. Production values live in the
# host's secret store and are never committed. See docs/02-adr-002-infrastructure.md
# ─────────────────────────────────────────────────────────────────────────────

# Postgres — `pnpm db:up` starts the container in compose.yaml; `pnpm db:url`
# prints the string it is actually bound to.
#
# FAZAIELI_DATABASE_PORT is the port the container publishes on 127.0.0.1. Change
# it here if something else already owns the default, and keep DATABASE_URL's
# port identical — the scripts read this file so the two never drift apart.
FAZAIELI_DATABASE_PORT="5432"
DATABASE_URL="postgresql://fazaieli:fazaieli_local@127.0.0.1:5432/fazaieli"

# Sessions — httpOnly, server-owned. NEVER a JWT in localStorage.
# BETTER_AUTH_SECRET must be at least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Peppers the placeholder identifier derived from a phone number. Same generator as above.
AUTH_IDENTIFIER_PEPPER=""

# Comma-separated. Must contain BETTER_AUTH_URL. https:// is required in production.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Client IP resolution behind a proxy. Both are REQUIRED in production and
# optional locally (no proxy in front of `next dev`).
# AUTH_CLIENT_IP_HEADER="x-forwarded-for"
# AUTH_TRUSTED_PROXIES="10.0.0.0/8"

# SMS — "fake" prints the OTP to the dev server console and sends nothing.
# It is rejected outright when NODE_ENV=production. Switch to "kavenegar"
# (and set SMS_API_KEY + SMS_TEMPLATE) only when real credentials exist.
SMS_PROVIDER="fake"
# SMS_API_KEY=""
# SMS_TEMPLATE=""

# Payments — bank transfer is live from day one; ZarinPal lands later.
PAYMENT_BANK_TRANSFER_ENABLED="true"
PAYMENT_BANK_CARD_NUMBER=""
PAYMENT_BANK_SHEBA=""
PAYMENT_BANK_HOLDER=""
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# Object storage (S3-compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
