# Postgres — hosted in Iran, beside the app (see docs/02-adr-002-infrastructure.md)
DATABASE_URL="postgres://user:pass@localhost:5432/fazaieli"

# Sessions — httpOnly, server-owned. NEVER a JWT in localStorage.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# SMS — Kavenegar / SMS.ir. Foreign providers will not serve Iran.
SMS_PROVIDER="kavenegar"
SMS_API_KEY=""
SMS_SENDER=""

# Payments — bank transfer is live from day one; ZarinPal lands later.
PAYMENT_BANK_TRANSFER_ENABLED="true"
PAYMENT_BANK_CARD_NUMBER=""
PAYMENT_BANK_SHEBA=""
PAYMENT_BANK_HOLDER=""
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# Object storage (S3-compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
